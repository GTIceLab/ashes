VERSION 5.5 ;
NAMESCASESENSITIVE ON ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN tsmc350_Trail ;

UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 500000.0 500000.0 ) ;

TRACKS X 3 DO 357 STEP 1400 LAYER METAL4 ;
