{
  "metadata": {
    "project_name": "inverter_test",
    "author": "arya",
    "version": "1.0",
    "notes": "Simple CMOS inverter"
  },

  "defaults": {
    "value": "1e-9",
    "fgswc_bias": "10e-6"
  },

  "resources": {
    "PFET0": {
      "enabled": true,
      "params": {
        "value": "1e-9"
      }
    },
    "NFET0": {
      "enabled": true,
      "params": {
        "value": "1e-9"
      }
    }
  },

  "io": {
    "inputs": [0],
    "outputs": [0]
  },

  "routing": {
    "power_block": {
      "dimensions": [30, 2],
      "column_labels": ["VDD", "GND"],
      "C": [],
      "T": [
        { "row": 16, "col": 1, "label": "PFET0_source_to_VDD" },
        { "row": 14, "col": 0, "label": "NFET0_source_to_GND" }
      ]
    },

    "matrix_a": {
      "dimensions": [30, 13],
      "C": [],
      "T": [
        { "row": 15, "col": 0, "label": "input_to_NFET_gate" },
        { "row": 13, "col": 0, "label": "input_to_PFET_gate" }
      ]
    },

    "matrix_b": {
      "dimensions": [30, 18],
      "C": [],
      "T": [
        { "row": 0, "col": 0, "label": "NFET_drain_to_output" },
        { "row": 0, "col": 0, "label": "PFET_drain_to_output" }
      ]
    }
  },

  "row_map": {
    "matrix_b": [
      { "row": 0,  "resource": "FGOTA0",   "pin": "pin0" },
      { "row": 1,  "resource": "FGOTA0",   "pin": "pin1" },

      { "row": 2,  "resource": "FGOTA1",   "pin": "pin0" },
      { "row": 3,  "resource": "FGOTA1",   "pin": "pin1" },

      { "row": 4,  "resource": "OTA0",     "pin": "pin0" },
      { "row": 5,  "resource": "OTA0",     "pin": "pin1" },

      { "row": 6,  "resource": "OTA1",     "pin": "pin0" },
      { "row": 7,  "resource": "OTA1",     "pin": "pin1" },

      { "row": 8,  "resource": "CAP0",     "pin": "pin0" },
      { "row": 9,  "resource": "CAP1",     "pin": "pin0" },
      { "row": 10, "resource": "CAP2",     "pin": "pin0" },
      { "row": 11, "resource": "CAP3",     "pin": "pin0" },

      { "row": 12, "resource": "NFET0",    "pin": "pin0" },
      { "row": 13, "resource": "NFET0",    "pin": "pin1" },

      { "row": 14, "resource": "NFET1",    "pin": "pin0" },
      { "row": 15, "resource": "NFET1",    "pin": "pin1" },

      { "row": 16, "resource": "PFET0",    "pin": "pin0" },
      { "row": 17, "resource": "PFET0",    "pin": "pin1" },

      { "row": 18, "resource": "PFET1",    "pin": "pin0" },
      { "row": 19, "resource": "PFET1",    "pin": "pin1" },

      { "row": 20, "resource": "TGATE0",   "pin": "pin0" },
      { "row": 21, "resource": "TGATE0",   "pin": "pin1" },

      { "row": 22, "resource": "TGATE1",   "pin": "pin0" },
      { "row": 23, "resource": "TGATE1",   "pin": "pin1" },

      { "row": 24, "resource": "TGATE2",   "pin": "pin0" },
      { "row": 25, "resource": "TGATE2",   "pin": "pin1" },

      { "row": 26, "resource": "TGATE3",   "pin": "pin0" },
      { "row": 27, "resource": "TGATE3",   "pin": "pin1" },

      { "row": 28, "resource": "NMIRROR0", "pin": "pin0" },
      { "row": 29, "resource": "NMIRROR1", "pin": "pin0" }
    ]
  }
}