VERSION 5.5 ;
NAMESCASESENSITIVE ON ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN Mod_WTA ;

UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 12000000.0 12000000.0 ) ;

TRACKS X 7 DO 8571 STEP 1400 LAYER METAL4 ;
TRACKS Y 7 DO 8571 STEP 1400 LAYER METAL4 ;
TRACKS X 6 DO 8571 STEP 1400 LAYER METAL3 ;
TRACKS Y 6 DO 8571 STEP 1400 LAYER METAL3 ;
