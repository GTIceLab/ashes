VERSION 5.5 ;
NAMESCASESENSITIVE ON ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN Sky130_Trail ;

UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 200000.0 200000.0 ) ;

TRACKS X 4 DO 62 STEP 3200 LAYER METAL5 ;
TRACKS Y 4 DO 62 STEP 3200 LAYER METAL5 ;
TRACKS X 3 DO 192 STEP 1040 LAYER METAL4 ;
TRACKS Y 3 DO 192 STEP 1040 LAYER METAL4 ;
TRACKS X 2 DO 312 STEP 640 LAYER METAL3 ;
TRACKS Y 2 DO 312 STEP 640 LAYER METAL3 ;
TRACKS X 1 DO 435 STEP 460 LAYER METAL2 ;
TRACKS Y 1 DO 435 STEP 460 LAYER METAL2 ;
TRACKS X 0 DO 500 STEP 400 LAYER METAL1 ;
TRACKS Y 0 DO 500 STEP 400 LAYER METAL1 ;

COMPONENTS 12 ;
- cab_frame tile_analog_frame + PLACED ( 0 0 ) N ;
- I_0_0_0_3 IndirectVMM_4x2 + PLACED ( 81330 61500 ) N ;
- I_0_0_1_3 IndirectVMM_4x2 + PLACED ( 81330 55000 ) N ;
- I_0_0_2_3 IndirectVMM_4x2 + PLACED ( 81330 48500 ) N ;
- I_0_0_3_3 IndirectVMM_4x2 + PLACED ( 81330 42000 ) N ;
- I_0_0_0_0 IndirectVMM_4x2 + PLACED ( 30000 61500 ) N ;
- I_0_0_0_1 IndirectVMM_4x2 + PLACED ( 47110 61500 ) N ;
- I_0_0_0_2 IndirectVMM_4x2 + PLACED ( 64220 61500 ) N ;
- I_1_0_0_0 TA_FGbias_1x2 + PLACED ( 110000 61500 ) N ;
- I_1_0_1_0 TA_FGbias_1x2 + PLACED ( 110000 55000 ) N ;
- I_1_0_2_0 TA_FGbias_1x2 + PLACED ( 110000 48500 ) N ;
- I_1_0_3_0 TA_FGbias_1x2 + PLACED ( 110000 42000 ) N ;
END COMPONENTS

